generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductImage {
  id Int @id @default(autoincrement())

  path String
  hash String?
  /// order in the gallery (0 = main photo), set in the admin panel (admin.kosmetichka-opt.ru)
  sortOrder Int @default(0)
  /// alt text of the photo (admin panel); empty — the product name
  alt       String?
  /// the uploaded original kept next to the optimised WebP (admin panel uploads)
  original  String?

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])

  variants ProductVariant[]
}

model Category {
  id Int @id @default(autoincrement())

  guid String @unique
  name String

  sortOrder  Int     @default(999)
  parentGuid String?

  parent   Category?  @relation("CategoryTree", fields: [parentGuid], references: [guid])
  children Category[] @relation("CategoryTree")

  products Product[]
}

model Brand {
  id   Int    @id @default(autoincrement())
  guid String @unique
  name String

  products Product[]
}

model Product {
  id Int @id @default(autoincrement())

  guid    String  @unique
  article String?

  name        String
  barcode     String?
  description String? @db.Text

  stock       Float?

  /// Admin panel (admin.kosmetichka-opt.ru): the product is not shown to customers (catalogue, search,
  /// product page, related strips, sitemap). Prices / stock still come from 1C.
  hidden          Boolean @default(false)
  /// the description was edited in the admin panel — the 1C import no longer overwrites it
  descriptionManual Boolean @default(false)
  seoTitle        String?
  seoDescription  String?
  /// characteristics shown on the product page: [{ "name": "Объём", "value": "250 мл" }]
  specs           Json?
  /// «Сопутствующие товары» chosen by hand, shown first in the «С этим берут» strip
  relatedIds      Int[]   @default([])
  /// SEO filled by a template (admin panel «Массовое SEO»); "manual" — typed by hand, templates don't overwrite it without asking
  seoSource       String?
  /// address of the product page: /product/<id>-<slug> (the id stays the key; slug only for people and search engines)
  slug            String?
  /// canonical URL set by hand (empty — the product's own address)
  canonicalUrl    String?
  /// marketing sections of the product card (admin panel), not from 1C
  shortDescription String? @db.Text
  features         String? @db.Text
  usage            String? @db.Text
  composition      String? @db.Text
  skinType         String?
  country          String?
  /// site labels: "new" («Новинка»), "hit» («Хит»)
  labels          String[] @default([])
  /// category / brand changed in the admin panel: the 1C import keeps writing *1C below but not these
  categoryManual  Boolean @default(false)
  brandManual     Boolean @default(false)
  categoryGuid1C  String?
  brandGuid1C     String?

  /// what a wholesaler may order: the shop («1. Мега Косметичка») minus the 12 it keeps + the warehouse (import-prices.js)

  wholesaleStock Int @default(0)
  minOrderQty Int    @default(1)
  /// Pieces sold in the last 90 days (orders except cancelled), recounted hourly — «ходовые» go first in the catalogue
  salesCount  Int    @default(0)
  /// has a «Скидка» price — the «Со скидкой» filter (recounted after each import-prices.js run)
  hasDiscount Boolean @default(false)
  prices      ProductPrice[]

  brandGuid String?
  brand     Brand?  @relation(fields: [brandGuid], references: [guid])

  categoryGuid String?
  category     Category? @relation(fields: [categoryGuid], references: [guid])

  images   ProductImage[]
  variants ProductVariant[]

  wishlistItems WishlistItem[]

  /// Stock per warehouse from 1C («Разбивать остатки по складам»). STAFF ONLY — never select it in customer APIs
  warehouseStock ProductWarehouseStock[]

  /// every barcode of the product in 1С («Штрихкоды номенклатуры», over OData); `barcode` above is the one of the exchange
  barcodes ProductBarcode[]

  /// receipts to the warehouse / transfers to the shop of the last days («Новые поступления», lib/arrivals.ts)
  arrivals ProductArrival[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryGuid])
  @@index([updatedAt(sort: Desc)])
  @@index([salesCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([wholesaleStock])
  @@index([hasDiscount])
  @@index([brandGuid])
  @@index([name])
  @@index([stock])
  @@index([hidden])
  @@index([slug])
  // trigram indexes for the «contains» search (pg_trgm) live in prisma/manual/2026-10-31-search-trigram.sql
}

/// «Новые поступления»: a product came to «0. Склад» (receipt, place "stock") or to «1. Мега Косметичка»
/// (transfer, place "shop") — from the posted 1С documents of the last days, rebuilt by scripts/import-arrivals.js.
/// firstReceiptAt — the product's first receipt ever: within the period → «Новинка».
/// SQL: prisma/manual/2026-11-12-product-arrivals.sql
model ProductArrival {
  id             Int       @id @default(autoincrement())
  productGuid    String
  product        Product   @relation(fields: [productGuid], references: [guid], onDelete: Cascade)
  place          String
  docRef         String
  docNumber      String
  docDate        DateTime
  qty            Float
  firstReceiptAt DateTime?

  @@unique([docRef, productGuid])
  @@index([docDate])
  @@index([productGuid])
}

/// All barcodes of a product from 1С (register «Штрихкоды номенклатуры», read over OData by
/// scripts/import-barcodes.js): the standard exchange gives only one. Search / scanner find a product by any.
/// SQL: prisma/manual/2026-11-12-product-barcodes.sql
model ProductBarcode {
  barcode     String
  productGuid String
  product     Product  @relation(fields: [productGuid], references: [guid], onDelete: Cascade)
  /// a packaging unit when the barcode is not of a piece (e.g. a box), its name from 1С if known
  unitRef     String?
  unitName    String?
  updatedAt   DateTime @updatedAt

  @@id([barcode, productGuid])
  @@index([productGuid])
}

/// A 1C warehouse (offers.xml «Склады»). Staff only.
model Warehouse {
  guid      String   @id
  name      String
  updatedAt DateTime @updatedAt

  stock ProductWarehouseStock[]
}

/// Stock of a product in one warehouse (offers.xml «Склад ИдСклада КоличествоНаСкладе»). Staff only:
/// customers see only Product.stock (the total). Only rows with qty > 0 are kept.
/// SQL: prisma/manual/2026-11-08-warehouse-stock.sql
model ProductWarehouseStock {
  productGuid   String
  product       Product   @relation(fields: [productGuid], references: [guid], onDelete: Cascade)
  warehouseGuid String
  warehouse     Warehouse @relation(fields: [warehouseGuid], references: [guid], onDelete: Cascade)
  qty           Float
  updatedAt     DateTime  @updatedAt

  @@id([productGuid, warehouseGuid])
  @@index([warehouseGuid])
}

model ProductVariant {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  imageId   Int
  image     ProductImage @relation(fields: [imageId], references: [id])
  name      String
  sortOrder Int          @default(0)

  @@index([productId])
}

model ProductPrice {
  id Int @id @default(autoincrement())

  productGuid String
  product     Product @relation(fields: [productGuid], references: [guid])

  priceType String
  price     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productGuid, priceType])
  @@index([priceType]) // speeds up sale-filter and price-sort pre-queries
}

model Customer {
  id Int @id @default(autoincrement())

  name        String?
  /// when the password was last changed: login tokens issued before it no longer work (lib/customerAuth.ts)
  passwordChangedAt DateTime?
  companyName String?
  phone       String? @unique
  email       String?

  inn     String?
  city    String?
  address String?
  /** wholesale request: where the customer resells — "offline" | "online" | "both" */
  shopType String?
  /** wholesale request: link to the online shop (site, Instagram, marketplace) */
  shopLink String?

  password String

  oneCId  String?
  manager String?

  priceType String @default("wholesale")
  /// Highest wholesale price type the admin granted ("wholesale" | "big_wholesale"); null — retail only.
  /// The customer switches freely between retail and anything up to this level.
  wholesaleAccess String?
  /// a wholesale customer also sees the retail price in the product card of the app — only the admin turns it on
  showRetailPrice Boolean @default(false)
  /// Customer's request for a higher price type ("wholesale" | "big_wholesale"), decided by an admin
  roleRequest       String?
  /// "pending" | "rejected" | "stale" (неактуальная: staff set it aside, a new request makes it pending again)
  roleRequestStatus String?
  roleRequestedAt   DateTime?
  /// Consent to promo push notifications (акции); order / bonus / chat notifications are always sent
  pushPromo         Boolean   @default(false)

  isActive   Boolean @default(true)
  /// MAXMA loyalty card number linked in the app (confirmed by an SMS code from MAXMA)
  loyaltyCard String? @unique
  /// the card's owner is in the 1С group «Максма Скидка» (lib/discountCard.ts, refreshed from 1С)
  maxmaDiscount Boolean @default(false)
  /// Card owner belongs to «Максма Розница»: retail prices and bonuses.
  maxmaRetail Boolean @default(false)
  /// Explicitly unlinked cards must not be reattached by the phone sync. Manual linking remains available.
  loyaltyUnlinkedCards String[] @default([])
  /// asked once right after signing up (app, owner 2026-11-10): «Как вы узнали о нас?»
  referralSource String?
  /// «Вы уже заказывали у нас?» (null — not answered)
  orderedBefore Boolean?
  /// when the two questions were answered or skipped (null — not asked yet)
  surveyAt DateTime?
  isApproved Boolean @default(false)
  /// a wholesale sign-up waiting for approval that staff set aside as «Неактуальные» (the customer changed
  /// his mind); registering again with the same phone brings it back to «Ожидают»
  requestStaleAt DateTime?

  role String @default("customer")

  orders        Order[]
  wishlistItems WishlistItem[]
  notifications Notification[]
  pushTokens    PushToken[]
  /** wholesale: proof of reselling (photos / videos of the shop or online orders) */
  proofs        CustomerProof[]
  cart          CustomerCart?
  favorites     CustomerFavorites?
  webPushSubs   WebPushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  // @@index([phone]) removed — @unique above already creates the index
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  login     String   @unique
  password  String
  role      String   @default("manager")
  position  String? // должность — указывает сам сотрудник при регистрации в тестах
  store     String? // магазин, где работает сотрудник
  oneCGroup String? // менеджер: его группа в 1С («Родитель») — видит только её клиентов и их заказы (lib/staffScope.ts)
  /// the password was changed: sessions signed in before it end (lib/auth.ts staffStillValid)
  passwordChangedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages       OrderMessage[]
  statusLogs     OrderStatusLog[]
  checks         OrderItemCheck[]
  assignedOrders Order[]          @relation("OrderPicker")
  academyAttempts AcademyAttempt[]
  webPushSubs     StaffWebPushSubscription[]
  pushTokens      StaffPushToken[]
}

model Order {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  status  String  @default("pending")
  total   Int     @default(0)
  /// Customer's price type when the order was placed (the customer can switch it later)
  priceType String?
  /// Prices the order's lines are at: «Опт» customers get them by the order sum (lib/pricing.ts cartPriceTier),
  /// recalculated when the manager changes the order; null — old orders (the customer's type)
  priceTier String?
  /// «pickup» (Заберу в магазине) | «delivery» (to deliveryAddress, may be empty — the manager asks); null — old orders
  deliveryType    String?
  deliveryAddress String? @db.Text
  comment String? @db.Text

  // Promo code (validated and calculated by MAXMA); discount in whole roubles, total already reduced by it
  promoCode String?
  discount  Int     @default(0)
  // MAXMA bonuses: ₽ discount from spent bonuses (1 bonus = 1 ₽, total already reduced by it)
  // and the accrual expected on confirm-order (shown to the customer)
  bonusesApplied   Int @default(0)
  bonusesCollected Int @default(0)

  items OrderItem[]

  oneCExportedAt    DateTime?
  /// «Заказ покупателя» created in 1С over OData (lib/onecOrders.ts, ORDERS_TO_1C=odata): its ref and number
  oneCRef           String?
  oneCNumber        String?
  /// wholesale: the second 1C document — the part from «0. Склад» («СК-…»); oneCRef / oneCNumber — the shop part («СА-…»)
  oneCStockRef    String?
  oneCStockNumber String?
  /// why it couldn't go to 1С (shown in the admin); retried at oneCNextTryAt
  oneCError         String?   @db.Text
  oneCNextTryAt     DateTime?
  /// a send in progress (claim); older than 10 min — the sender died, the next try looks the document up first
  oneCSendingAt     DateTime?
  bitrixDealId      Int?
  customerConfirmed Boolean  @default(false)
  changesSnapshot   Json?
  /// Staff changed the items and wait for the customer to confirm: «Заказ оформлен» (payment) is
  /// blocked until then. Cleared when the customer confirms or changes the order himself.
  confirmRequestedAt DateTime?
  /// the customer saw the order chat up to this manager message (any device) — /api/orders/status hides older ones
  customerChatSeenAt DateTime?
  /// Reminders already sent about that confirmation (push after 2 h and after 24 h)
  confirmReminders   Int       @default(0)

  pickerId Int?
  picker   User? @relation("OrderPicker", fields: [pickerId], references: [id])

  messages    OrderMessage[]
  statusLogs  OrderStatusLog[]
  itemChanges OrderItemChange[]
  oneCAttempts OneCOrderAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt]) // used in admin order lists and 1C export ordering
  @@index([confirmRequestedAt]) // reminders: orders waiting for the customer's confirmation
}

/// Every try to send an order to 1С (lib/onecOrders.ts) — the log in the admin panel (/orders/<id>)
model OneCOrderAttempt {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  durationMs Int      @default(0)
  /// created (document made) | linked (already was in 1С) | problem (data: no customer, contract…) | error (1С / network)
  outcome    String
  /// immediate (right after «Заказ оформлен») | auto (the worker, by schedule) | manual (the button in the admin panel)
  trigger    String   @default("auto")
  by         String?
  /// 1С document number(s) after the try
  docNumber  String?
  error      String?  @db.Text

  @@index([orderId, at])
  @@index([at])
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  productId   Int
  productName String
  barcode     String?
  quantity    Int
  /// wholesale: how many come from which 1C warehouse { "<warehouse guid>": qty } (picker's choice; null = the 12-piece rule, lib/orderWarehouses.ts)
  warehouseQty Json?
  price       Int
  total       Int
  // Promo-code discount for this line, whole roubles (line sum to pay = total - discount)
  discount    Int     @default(0)
  // Discount from spent MAXMA bonuses for this line, whole roubles (to pay = total - discount - bonusDiscount)
  bonusDiscount Int   @default(0)

  variantName     String?
  variantImageUrl String?

  check  OrderItemCheck?
  photos OrderItemPhoto[]

  @@index([orderId])
  @@index([productId])
}

/// History of changes to order lines: who (manager / customer) added, removed or changed what.
/// The customer sees the manager's changes, staff see the customer's — nothing goes unnoticed.
model OrderItemChange {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The line (kept after it was removed — then no OrderItem has this id any more)
  orderItemId Int?
  productId   Int?
  productName String
  barcode     String?
  /// "added" | "removed" | "changed"
  kind        String
  /// "staff" | "customer"
  side        String
  /// Staff member's name / «Битрикс24»; null for the customer
  actorName   String?
  oldQuantity Int?
  newQuantity Int?
  oldPrice    Int?
  newPrice    Int?
  oldVariant  String?
  newVariant  String?
  /// Variant photo of the line (removed lines have no OrderItem to take it from)
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItemCheck {
  id          Int       @id @default(autoincrement())
  orderItemId Int       @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  // "ok" | "out_of_stock" | "expired" | "bad_condition" | "insufficient_qty"
  status       String @default("ok")
  note         String? @db.Text
  availableQty Int?

  // Picker who performed the check
  pickerId Int?
  picker   User? @relation(fields: [pickerId], references: [id])

  checkedAt DateTime @default(now()) @updatedAt
}

model OrderItemPhoto {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  url       String
  createdAt DateTime @default(now())
}

model OrderMessage {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])
  userId  Int?
  user    User? @relation(fields: [userId], references: [id])

  text         String  @db.Text
  isFromPicker Boolean @default(false)
  // "customer" = customer↔manager chat; "picker" = picker↔manager chat
  source       String  @default("customer")

  // Dedup key for Bitrix webhook-pushed manager replies (customer chat only)
  bitrixCommentId String? @unique

  createdAt DateTime @default(now())

  @@index([orderId, source])
  @@index([orderId, createdAt]) // efficient pagination of message history
}

model OrderStatusLog {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])
  userId  Int?
  user    User? @relation(fields: [userId], references: [id])

  fromStatus String?
  toStatus   String

  createdAt DateTime @default(now())

  @@index([orderId])
}

model OneCCustomer {
  id Int @id @default(autoincrement())

  oneCId String  @unique
  name   String
  phone  String?

  manager   String?
  priceType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmsCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@index([phone, expiresAt])
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// Persistent login rate-limiter — survives server restarts and multi-instance deploys
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Outbox of MAXMA lifecycle calls for site orders «site-<orderId>» (v2/set-order, confirm-order,
// cancel-order). Tasks of one order run strictly in order (createdAt, id); failures are retried
// with backoff by lib/maxmaQueue.ts (worker started from instrumentation.ts). No FK: a "cancel"
// may refer to an order whose creation was rolled back (its MAXMA reservation must be released).
model MaxmaTask {
  id        Int      @id @default(autoincrement())
  orderId   Int
  action    String // "set" | "confirm" | "cancel"
  payload   Json? // "set": the v2 calculationQuery to send
  status    String   @default("pending") // "pending" | "done" | "failed"
  attempts  Int      @default(0)
  lastError String?
  nextAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAt])
  @@index([orderId])
}

// ── Тесты для сотрудников (test.kosmetichka-opt.ru → /academy) ────────────────────────────────
// Тесты загружаются из academy/tests/*.json скриптом scripts/import-tests.js (upsert по slug;
// вопросы теста при повторной загрузке заменяются целиком). Попытка хранит снимок вопросов и
// ответов в JSON, поэтому старые результаты не ломаются после правки теста.
model AcademyTest {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  description  String?  @db.Text
  passScore    Int      @default(80) // % правильных ответов для «сдал»
  timeLimitMin Int? // ограничение по времени, минут (null — без ограничения)
  showAnswers  Boolean  @default(true) // показывать правильные ответы после сдачи
  shuffle      Boolean  @default(true) // перемешивать вопросы и варианты
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions AcademyQuestion[]
  attempts  AcademyAttempt[]
}

model AcademyQuestion {
  id          Int         @id @default(autoincrement())
  testId      Int
  test        AcademyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  order       Int
  text        String      @db.Text
  explanation String?     @db.Text // пояснение после ответа
  productId   Int? // товар каталога — его картинка показывается в вопросе (без FK: товары приходят из 1С)

  options AcademyOption[]

  @@index([testId])
}

model AcademyOption {
  id         Int             @id @default(autoincrement())
  questionId Int
  question   AcademyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String          @db.Text
  isCorrect  Boolean         @default(false)

  @@index([questionId])
}

model AcademyAttempt {
  id           Int         @id @default(autoincrement())
  testId       Int
  test         AcademyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int // % правильных
  correctCount Int
  total        Int
  passed       Boolean
  details      Json // снимок: [{ text, options: [{ text, isCorrect, chosen }], correct }]
  startedAt    DateTime
  finishedAt   DateTime    @default(now())

  @@index([testId, finishedAt])
  @@index([userId, finishedAt])
}

/// Errors and crashes reported by the mobile apps (POST /api/app-errors), grouped by `hash`
model AppError {
  id        Int      @id @default(autoincrement())
  hash      String   @unique
  app       String // "customer" | "team"
  platform  String // "ios" | "android"
  version   String?
  message   String   @db.Text
  stack     String?  @db.Text
  screen    String?
  fatal     Boolean  @default(false)
  count     Int      @default(1)
  customers Int[]    @default([])
  firstAt   DateTime @default(now())
  lastAt    DateTime @default(now())

  @@index([lastAt(sort: Desc)])
}

/// In-app notifications («Уведомления» in the app, bell dot); also sent as push to the customer's phones
model Notification {
  id         Int       @id @default(autoincrement())
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String // "order" | "chat" | "restock" | "bonus" | "role" | "promo"
  title      String
  body       String    @db.Text
  /// in-app route to open on tap, e.g. "/order/12", "/product/5"
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt(sort: Desc)])
}

/// Expo push tokens of the customer's devices (one per installed app)
model PushToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([customerId])
}

/// Browser Web Push subscription (site / home-screen web app), one per browser
model WebPushSubscription {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([customerId])
}

/// Browser Web Push for staff: the admin website (/admin, Team web app) on this browser
model StaffWebPushSubscription {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// Promo push campaigns sent from the admin panel («Рассылки»)
model PushBroadcast {
  id         Int      @id @default(autoincrement())
  title      String
  body       String   @db.Text
  audience   String // "all" | "retail" | "wholesale" | "big_wholesale"
  link       String?
  recipients Int      @default(0)
  devices    Int      @default(0)
  userId     Int?
  createdAt  DateTime @default(now())
}

/// Expo push tokens of the staff app «Косметичка Team» on phones (lib/staffNotify.ts)
model StaffPushToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/** Photos / videos a wholesale applicant sends to prove he resells (shop, online orders). Staff see them in the customer card. */
model CustomerProof {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /** "img" | "video" */
  kind       String
  /** file name in DATA_DIR/proofs */
  file       String
  mime       String
  size       Int
  createdAt  DateTime @default(now())

  @@index([customerId])
}

/// The customer's cart, shared by all his devices (site, phone apps). `items` — the lines as the apps
/// keep them (product snapshot + cartKey + quantity); the apps refresh prices and stock themselves.
/// the customer's favourites, the same on the site and in the apps (GET/PUT /api/mobile/favorites)
model CustomerFavorites {
  customerId Int      @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      Json
  updatedAt  DateTime @updatedAt
}

model CustomerCart {
  customerId Int      @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      Json
  comment    String   @default("")
  updatedAt  DateTime @updatedAt
}

/// Admin panel: every change made by staff (who, what, before/after). SQL: prisma/manual/2026-11-12-cms.sql
model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String
  action    String
  entity    String
  entityId  String?
  summary   String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
}

/// Admin panel: an editable page of the storefront (now "home"): a draft, the published version
/// the apps show, and the history of published versions (rollback)
model SitePage {
  id             Int       @id @default(autoincrement())
  key            String    @unique
  title          String
  draft          Json
  draftUpdatedAt DateTime  @default(now())
  draftUpdatedBy String?
  published      Json?
  publishedAt    DateTime?
  publishedBy    String?

  versions SitePageVersion[]
}

model SitePageVersion {
  id        Int      @id @default(autoincrement())
  pageId    Int
  page      SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content   Json
  note      String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([pageId, createdAt(sort: Desc)])
}

/// Admin panel: a banner (separate pictures for computer and phone), placed on the home page by its blocks
model Banner {
  id           Int       @id @default(autoincrement())
  title        String
  subtitle     String?
  buttonText   String?
  link         String?
  imageDesktop String?
  imageMobile  String?
  active       Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  /// deleted from the admin panel (kept for the history, restorable)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Admin panel: a background job (big photo imports): progress, retries, error log. SQL: prisma/manual/2026-11-12-cms-stage2.sql
model CmsJob {
  id          Int       @id @default(autoincrement())
  type        String
  status      String    @default("queued") // queued | running | done | failed | cancelled
  title       String
  payload     Json
  total       Int       @default(0)
  done        Int       @default(0)
  failed      Int       @default(0)
  result      Json?
  errors      Json?
  attempts    Int       @default(0)
  lockedUntil DateTime?
  createdBy   String
  userId      Int?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, createdAt])
}

/// Admin panel: a bulk change of products with the values before it (undo)
model CmsBulkOperation {
  id        Int       @id @default(autoincrement())
  type      String
  summary   String
  count     Int
  changes   Json
  userName  String
  createdAt DateTime  @default(now())
  undoneAt  DateTime?
  undoneBy  String?

  @@index([createdAt(sort: Desc)])
}

/// Admin panel settings (SEO templates, …)
model CmsSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}
