generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductImage {
  id Int @id @default(autoincrement())

  path String
  hash String?

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])

  variants ProductVariant[]
}

model Category {
  id Int @id @default(autoincrement())

  guid String @unique
  name String

  sortOrder  Int     @default(999)
  parentGuid String?

  parent   Category?  @relation("CategoryTree", fields: [parentGuid], references: [guid])
  children Category[] @relation("CategoryTree")

  products Product[]
}

model Brand {
  id   Int    @id @default(autoincrement())
  guid String @unique
  name String

  products Product[]
}

model Product {
  id Int @id @default(autoincrement())

  guid    String  @unique
  article String?

  name        String
  barcode     String?
  description String? @db.Text

  stock       Float?
  minOrderQty Int    @default(1)
  /// Pieces sold in the last 90 days (orders except cancelled), recounted hourly — «ходовые» go first in the catalogue
  salesCount  Int    @default(0)
  prices      ProductPrice[]

  brandGuid String?
  brand     Brand?  @relation(fields: [brandGuid], references: [guid])

  categoryGuid String?
  category     Category? @relation(fields: [categoryGuid], references: [guid])

  images   ProductImage[]
  variants ProductVariant[]

  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryGuid])
  @@index([updatedAt(sort: Desc)])
  @@index([salesCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([brandGuid])
  @@index([name])
}

model ProductVariant {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  imageId   Int
  image     ProductImage @relation(fields: [imageId], references: [id])
  name      String
  sortOrder Int          @default(0)

  @@index([productId])
}

model ProductPrice {
  id Int @id @default(autoincrement())

  productGuid String
  product     Product @relation(fields: [productGuid], references: [guid])

  priceType String
  price     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productGuid, priceType])
  @@index([priceType]) // speeds up sale-filter and price-sort pre-queries
}

model Customer {
  id Int @id @default(autoincrement())

  name        String?
  companyName String?
  phone       String? @unique
  email       String?

  inn     String?
  city    String?
  address String?

  password String

  oneCId  String?
  manager String?

  priceType String @default("wholesale")
  /// Highest wholesale price type the admin granted ("wholesale" | "big_wholesale"); null — retail only.
  /// The customer switches freely between retail and anything up to this level.
  wholesaleAccess String?
  /// Customer's request for a higher price type ("wholesale" | "big_wholesale"), decided by an admin
  roleRequest       String?
  /// "pending" | "rejected"
  roleRequestStatus String?
  roleRequestedAt   DateTime?
  /// Consent to promo push notifications (акции); order / bonus / chat notifications are always sent
  pushPromo         Boolean   @default(false)

  isActive   Boolean @default(true)
  /// MAXMA loyalty card number linked in the app (confirmed by an SMS code from MAXMA)
  loyaltyCard String?
  isApproved Boolean @default(false)

  role String @default("customer")

  orders        Order[]
  wishlistItems WishlistItem[]
  notifications Notification[]
  pushTokens    PushToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  // @@index([phone]) removed — @unique above already creates the index
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  login     String   @unique
  password  String
  role      String   @default("manager")
  position  String? // должность — указывает сам сотрудник при регистрации в тестах
  store     String? // магазин, где работает сотрудник
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages       OrderMessage[]
  statusLogs     OrderStatusLog[]
  checks         OrderItemCheck[]
  assignedOrders Order[]          @relation("OrderPicker")
  academyAttempts AcademyAttempt[]
}

model Order {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  status  String  @default("pending")
  total   Int     @default(0)
  /// Customer's price type when the order was placed (the customer can switch it later)
  priceType String?
  comment String? @db.Text

  // Promo code (validated and calculated by MAXMA); discount in whole roubles, total already reduced by it
  promoCode String?
  discount  Int     @default(0)
  // MAXMA bonuses: ₽ discount from spent bonuses (1 bonus = 1 ₽, total already reduced by it)
  // and the accrual expected on confirm-order (shown to the customer)
  bonusesApplied   Int @default(0)
  bonusesCollected Int @default(0)

  items OrderItem[]

  oneCExportedAt    DateTime?
  bitrixDealId      Int?
  customerConfirmed Boolean  @default(false)
  changesSnapshot   Json?
  /// Staff changed the items and wait for the customer to confirm: «Заказ оформлен» (payment) is
  /// blocked until then. Cleared when the customer confirms or changes the order himself.
  confirmRequestedAt DateTime?
  /// Reminders already sent about that confirmation (push after 2 h and after 24 h)
  confirmReminders   Int       @default(0)

  pickerId Int?
  picker   User? @relation("OrderPicker", fields: [pickerId], references: [id])

  messages    OrderMessage[]
  statusLogs  OrderStatusLog[]
  itemChanges OrderItemChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt]) // used in admin order lists and 1C export ordering
  @@index([confirmRequestedAt]) // reminders: orders waiting for the customer's confirmation
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  productId   Int
  productName String
  barcode     String?
  quantity    Int
  price       Int
  total       Int
  // Promo-code discount for this line, whole roubles (line sum to pay = total - discount)
  discount    Int     @default(0)
  // Discount from spent MAXMA bonuses for this line, whole roubles (to pay = total - discount - bonusDiscount)
  bonusDiscount Int   @default(0)

  variantName     String?
  variantImageUrl String?

  check  OrderItemCheck?
  photos OrderItemPhoto[]

  @@index([orderId])
  @@index([productId])
}

/// History of changes to order lines: who (manager / customer) added, removed or changed what.
/// The customer sees the manager's changes, staff see the customer's — nothing goes unnoticed.
model OrderItemChange {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The line (kept after it was removed — then no OrderItem has this id any more)
  orderItemId Int?
  productId   Int?
  productName String
  barcode     String?
  /// "added" | "removed" | "changed"
  kind        String
  /// "staff" | "customer"
  side        String
  /// Staff member's name / «Битрикс24»; null for the customer
  actorName   String?
  oldQuantity Int?
  newQuantity Int?
  oldPrice    Int?
  newPrice    Int?
  oldVariant  String?
  newVariant  String?
  /// Variant photo of the line (removed lines have no OrderItem to take it from)
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItemCheck {
  id          Int       @id @default(autoincrement())
  orderItemId Int       @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  // "ok" | "out_of_stock" | "expired" | "bad_condition" | "insufficient_qty"
  status       String @default("ok")
  note         String? @db.Text
  availableQty Int?

  // Picker who performed the check
  pickerId Int?
  picker   User? @relation(fields: [pickerId], references: [id])

  checkedAt DateTime @default(now()) @updatedAt
}

model OrderItemPhoto {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  url       String
  createdAt DateTime @default(now())
}

model OrderMessage {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])
  userId  Int?
  user    User? @relation(fields: [userId], references: [id])

  text         String  @db.Text
  isFromPicker Boolean @default(false)
  // "customer" = customer↔manager chat; "picker" = picker↔manager chat
  source       String  @default("customer")

  // Dedup key for Bitrix webhook-pushed manager replies (customer chat only)
  bitrixCommentId String? @unique

  createdAt DateTime @default(now())

  @@index([orderId, source])
  @@index([orderId, createdAt]) // efficient pagination of message history
}

model OrderStatusLog {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])
  userId  Int?
  user    User? @relation(fields: [userId], references: [id])

  fromStatus String?
  toStatus   String

  createdAt DateTime @default(now())

  @@index([orderId])
}

model OneCCustomer {
  id Int @id @default(autoincrement())

  oneCId String  @unique
  name   String
  phone  String?

  manager   String?
  priceType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmsCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@index([phone, expiresAt])
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// Persistent login rate-limiter — survives server restarts and multi-instance deploys
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Outbox of MAXMA lifecycle calls for site orders «site-<orderId>» (v2/set-order, confirm-order,
// cancel-order). Tasks of one order run strictly in order (createdAt, id); failures are retried
// with backoff by lib/maxmaQueue.ts (worker started from instrumentation.ts). No FK: a "cancel"
// may refer to an order whose creation was rolled back (its MAXMA reservation must be released).
model MaxmaTask {
  id        Int      @id @default(autoincrement())
  orderId   Int
  action    String // "set" | "confirm" | "cancel"
  payload   Json? // "set": the v2 calculationQuery to send
  status    String   @default("pending") // "pending" | "done" | "failed"
  attempts  Int      @default(0)
  lastError String?
  nextAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAt])
  @@index([orderId])
}

// ── Тесты для сотрудников (test.kosmetichka-opt.ru → /academy) ────────────────────────────────
// Тесты загружаются из academy/tests/*.json скриптом scripts/import-tests.js (upsert по slug;
// вопросы теста при повторной загрузке заменяются целиком). Попытка хранит снимок вопросов и
// ответов в JSON, поэтому старые результаты не ломаются после правки теста.
model AcademyTest {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  description  String?  @db.Text
  passScore    Int      @default(80) // % правильных ответов для «сдал»
  timeLimitMin Int? // ограничение по времени, минут (null — без ограничения)
  showAnswers  Boolean  @default(true) // показывать правильные ответы после сдачи
  shuffle      Boolean  @default(true) // перемешивать вопросы и варианты
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions AcademyQuestion[]
  attempts  AcademyAttempt[]
}

model AcademyQuestion {
  id          Int         @id @default(autoincrement())
  testId      Int
  test        AcademyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  order       Int
  text        String      @db.Text
  explanation String?     @db.Text // пояснение после ответа
  productId   Int? // товар каталога — его картинка показывается в вопросе (без FK: товары приходят из 1С)

  options AcademyOption[]

  @@index([testId])
}

model AcademyOption {
  id         Int             @id @default(autoincrement())
  questionId Int
  question   AcademyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String          @db.Text
  isCorrect  Boolean         @default(false)

  @@index([questionId])
}

model AcademyAttempt {
  id           Int         @id @default(autoincrement())
  testId       Int
  test         AcademyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int // % правильных
  correctCount Int
  total        Int
  passed       Boolean
  details      Json // снимок: [{ text, options: [{ text, isCorrect, chosen }], correct }]
  startedAt    DateTime
  finishedAt   DateTime    @default(now())

  @@index([testId, finishedAt])
  @@index([userId, finishedAt])
}

/// Errors and crashes reported by the mobile apps (POST /api/app-errors), grouped by `hash`
model AppError {
  id        Int      @id @default(autoincrement())
  hash      String   @unique
  app       String // "customer" | "team"
  platform  String // "ios" | "android"
  version   String?
  message   String   @db.Text
  stack     String?  @db.Text
  screen    String?
  fatal     Boolean  @default(false)
  count     Int      @default(1)
  customers Int[]    @default([])
  firstAt   DateTime @default(now())
  lastAt    DateTime @default(now())

  @@index([lastAt(sort: Desc)])
}

/// In-app notifications («Уведомления» in the app, bell dot); also sent as push to the customer's phones
model Notification {
  id         Int       @id @default(autoincrement())
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String // "order" | "chat" | "restock" | "bonus" | "role" | "promo"
  title      String
  body       String    @db.Text
  /// in-app route to open on tap, e.g. "/order/12", "/product/5"
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt(sort: Desc)])
}

/// Expo push tokens of the customer's devices (one per installed app)
model PushToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([customerId])
}

/// Promo push campaigns sent from the admin panel («Рассылки»)
model PushBroadcast {
  id         Int      @id @default(autoincrement())
  title      String
  body       String   @db.Text
  audience   String // "all" | "retail" | "wholesale" | "big_wholesale"
  link       String?
  recipients Int      @default(0)
  devices    Int      @default(0)
  userId     Int?
  createdAt  DateTime @default(now())
}
